# Cleenzo public API (NestJS) — required for /order and /invoice WhatsApp links.
REACT_APP_CLEENZO_API_URL=https://api.cleenzo.co.in/api/v1

# Organization whose ERP catalog prices power #pricing (default shine-works).
REACT_APP_CLEENZO_ORG_SLUG=shine-works

# Local dev:
# REACT_APP_CLEENZO_API_URL=http://localhost:3001/api/v1
